# Mock GitHub Repository Secrets. Never store real credentials here.
# This is a secret inventory, not the project's runtime .env.

SERVER_HOST=203.0.113.10
SERVER_USER=deploy_user
SERVER_ROOT_SSH_KEY=MOCK_PRIVATE_SSH_KEY
SERVER_KNOWN_HOSTS=203.0.113.10 ssh-ed25519 AAAAMOCK

DOMAIN=example.com
API_DOMAIN=api.example.com
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=mock_postgres_password

# Required native Yandex API backup secret: full multiline rclone configuration.
# See rclone-api.conf.example; supply the real value directly to GitHub Secrets.
YANDEX_DISK_API_CONFIG=MOCK_MULTILINE_RCLONE_CONFIG
# Repository VARIABLE, not a private key:
BACKUP_RECIPIENT=ssh-ed25519 AAAAMOCK owner

# Optional legacy WebDAV only; not used by the daily complete backup timer.
YANDEX_DISK_USERNAME=user@example.com
YANDEX_DISK_APP_PASSWORD=mock_yandex_app_password
RCLONE_REMOTE_PATH=kartochki-online/postgres
